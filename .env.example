# Production template. Bootstrap generates a separate private local configuration.
# Use distinct random secrets; PostgreSQL password must be >=16 characters.
# URLs: postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@db:5432/yatra_kavach
# SYNC_DATABASE_URL uses postgresql+psycopg:// with the same connection.
DOMAIN=yatrakavach.<domain>
PUBLIC_ORIGIN=https://yatrakavach.<domain>
CONTACT_EMAIL=
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
POSTGRES_DB=yatra_kavach
POSTGRES_USER=yatra
POSTGRES_PASSWORD=
DATABASE_URL=
SYNC_DATABASE_URL=
SECRET_KEY=
QR_HMAC_SECRET=
JWT_SECRET=
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=
STAFF_HEALTH_EMAIL=
STAFF_HEALTH_PASSWORD=
STAFF_POLICE_EMAIL=
STAFF_POLICE_PASSWORD=
STAFF_RESCUE_EMAIL=
STAFF_RESCUE_PASSWORD=
STAFF_VOLUNTEER_EMAIL=
STAFF_VOLUNTEER_PASSWORD=
CONTROL_ROOM_PHONE=
SOS_FALLBACK_SMS_NUMBER=
NOTIFIER_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REVIEWED_BY=
RETENTION_DAYS=30
